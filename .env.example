# Copy to .env.local and fill in only what you need.
# Never commit .env.local or paste real keys into the repo, README, or issues.

# --- LLM analyst (pick one provider) ---
# LLM_PROVIDER=groq
# LLM_PROVIDER=gemini
# LLM_PROVIDER=ollama

# Groq (hosted; good default for deploys)
# GROQ_API_KEY=
# GROQ_ANALYST_MODEL=llama-3.1-8b-instant

# Google Gemini
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_ANALYST_MODEL=gemini-2.5-flash-lite

# Ollama (local; no cloud key)
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# LLM_CACHE_TTL_MS=21600000
# LOG_LEVEL=warn

# --- News & sentiment (Google News RSS works with no keys) ---
# SENTIMENT_GOOGLE_NEWS_RSS=1
# SENTIMENT_CACHE_TTL_MS=1800000
# GNEWS_API_KEY=
# NEWS_API_KEY=

# --- Fixtures (optional; bundled schedule works without this) ---
# FOOTBALL_DATA_ORG_TOKEN=

# --- Rate limits (optional; for public deploys) ---
# ANALYZE_RATE_LIMIT_MAX=20
# ANALYZE_RATE_LIMIT_WINDOW_MS=60000
